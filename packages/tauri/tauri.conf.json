{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto-Exit",
  "version": "0.2.1-dev",
  "identifier": "com.autoexit.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @solana-auto-exit/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm -w run build:tauri-prep",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Auto-Exit",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:7777 http://localhost:7777; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Self-hosted auto-exit bot for Solana LP positions.",
    "longDescription": "Watches Orca and Meteora liquidity positions on Solana and closes them when price hits a take-profit or stop-loss trigger. Runs locally; key encrypted on disk.",
    "copyright": "Copyright (c) 2026 Pedro Lozano",
    "publisher": "Pedro Lozano",
    "externalBin": [
      "binaries/auto-exit-server"
    ],
    "resources": [
      "binaries/server-app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNDhFOEVEOTIyNDgzNEQKUldSTmd5U1M3ZWhJb3A2a0VvSitSVmRrSG1aZE1oNmthWGpPcHF6RzRqdEl1MWJ3VmNVTUdyaGQK",
      "endpoints": [
        "https://github.com/pedrojorgelozano/Solana-Auto-Exit/releases/latest/download/latest.json"
      ]
    }
  }
}
