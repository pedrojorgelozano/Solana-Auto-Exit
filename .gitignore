packages/web/next-env.d.ts
next-env.d.ts

# TypeScript incremental build cache
*.tsbuildinfo
**/*.tsbuildinfo

# Tauri (Rust) build artifacts
**/target/
packages/tauri/gen/

# Sidecar del server, generado por `pnpm build:server-binary`: el runtime de
# Bun (auto-exit-server-*) y el server desplegado (server-app/, incluye su
# node_modules y drizzle). Se versiona solo el .gitkeep para que el dir exista.
packages/tauri/binaries/auto-exit-server-*
packages/tauri/binaries/server-app/

# Next.js static export output (input para tauri build)
packages/web/out/

# Local tooling (gitleaks binary, scan reports). El binario se descarga
# bajo demanda; el report es output del scan y no se commitea.
.tools/

