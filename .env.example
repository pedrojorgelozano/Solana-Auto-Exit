# ======================== solana-auto-exit · CONFIG ==========================
# Copia este archivo a `.env` y rellena los valores.
# .env NUNCA debe subirse a git.
# =============================================================================

# --- Comunes (las lee el núcleo) ---------------------------------------------

# Protocolo a usar. Por ahora solo "orca". Próximamente: "meteora".
PROTOCOL=orca

# Red: "devnet" (recomendado para probar) o "mainnet".
NETWORK=devnet

# RPC. En mainnet usa un endpoint privado (Helius, Triton, QuickNode...).
# El RPC público se satura y romperá el bot.
RPC_URL=https://api.devnet.solana.com

# Objetivo de salida. Precio en "token B por unidad de token A"
# (p. ej. en SOL/USDC = cuántos USDC vale 1 SOL).
TARGET_PRICE=170

# "above" = take-profit (sale si el precio SUBE hasta TARGET_PRICE)
# "below" = stop / buy-the-dip (sale si el precio BAJA hasta TARGET_PRICE)
DIRECTION=above

# Slippage tolerado al cerrar, en basis points (100 = 1%).
SLIPPAGE_BPS=100

# Intervalo de polling, en milisegundos. Mínimo 1000.
POLL_MS=30000

# Ruta al keypair de la wallet (array JSON estilo Solana CLI).
# Este archivo controla fondos reales. Está en .gitignore.
WALLET_PATH=wallet.json

# DRY_RUN=true -> al disparar SOLO loguea, NO envía transacción.
# Mantener en true mientras se prueba.
DRY_RUN=true

# Seguro extra para mainnet en vivo. Solo si NETWORK=mainnet y DRY_RUN=false,
# necesitas además ALLOW_MAINNET_LIVE=true para que el bot arranque.
ALLOW_MAINNET_LIVE=false

# (Opcional) Auto-swap tras cerrar: si está fijado, el bot swapea lo recibido
# del cierre al token indicado (en la misma pool). En v1 debe ser uno de los
# dos tokens del pool de la posición.
# EXIT_TOKEN_MINT=

# (Opcional) Slippage para el swap de salida. Si no se define, se usa SLIPPAGE_BPS.
# EXIT_SWAP_SLIPPAGE_BPS=100

# --- Específicas de Orca -----------------------------------------------------

# Mint del NFT que representa tu posición Whirlpool.
ORCA_POSITION_MINT=PON_AQUI_EL_MINT_DE_TU_POSICION

# Decimales de los tokens del par (SOL=9, USDC=6, etc.).
ORCA_DECIMALS_A=9
ORCA_DECIMALS_B=6
