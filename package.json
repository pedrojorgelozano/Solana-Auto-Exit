{
  "name": "solana-auto-exit",
  "version": "0.1.0",
  "private": true,
  "description": "Framework de auto-exit para posiciones de liquidez en protocolos DeFi de Solana.",
  "type": "module",
  "scripts": {
    "start": "tsx packages/cli/src/main.ts",
    "dev:server": "pnpm --filter @solana-auto-exit/server dev",
    "start:server": "pnpm --filter @solana-auto-exit/server start",
    "dev:web": "pnpm --filter @solana-auto-exit/web dev",
    "build:web": "pnpm --filter @solana-auto-exit/web build",
    "db:generate": "pnpm --filter @solana-auto-exit/server exec drizzle-kit generate",
    "typecheck": "tsc --noEmit && pnpm --filter @solana-auto-exit/web typecheck",
    "gen-wallet": "tsx scripts/gen-wallet.ts",
    "export-base58": "tsx scripts/export-base58.ts",
    "inspect-pool": "tsx scripts/inspect-pool.ts"
  },
  "devDependencies": {
    "@orca-so/whirlpools-client": "^7.0.0",
    "@solana/kit": "^5.5.1",
    "@types/node": "^22.19.19",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
