{
  "name": "solana-auto-exit",
  "version": "0.2.0-dev",
  "private": true,
  "description": "Framework de auto-exit para posiciones de liquidez en protocolos DeFi de Solana.",
  "type": "module",
  "scripts": {
    "start": "tsx packages/cli/src/main.ts",
    "dev:server": "pnpm --filter @solana-auto-exit/server dev",
    "start:server": "pnpm --filter @solana-auto-exit/server start",
    "dev:web": "pnpm --filter @solana-auto-exit/web dev",
    "build:web": "pnpm --filter @solana-auto-exit/web build",
    "build:web-export": "cross-env TAURI_BUILD=1 pnpm --filter @solana-auto-exit/web build",
    "build:server-binary": "pnpm --filter @solana-auto-exit/server build:binary",
    "build:tauri-prep": "pnpm build:web-export && pnpm build:server-binary",
    "tauri:dev": "pnpm --filter @solana-auto-exit/tauri exec tauri dev",
    "tauri:build": "pnpm --filter @solana-auto-exit/tauri exec tauri build",
    "tauri:release": "pnpm --filter @solana-auto-exit/tauri exec tauri build --config tauri.updater.conf.json",
    "db:generate": "pnpm --filter @solana-auto-exit/server exec drizzle-kit generate",
    "typecheck": "tsc --noEmit && pnpm --filter @solana-auto-exit/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen-wallet": "tsx scripts/gen-wallet.ts",
    "export-base58": "tsx scripts/export-base58.ts",
    "inspect-pool": "tsx scripts/inspect-pool.ts"
  },
  "devDependencies": {
    "@orca-so/whirlpools-client": "^7.0.0",
    "@solana/kit": "^5.5.1",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^4.1.7",
    "cross-env": "^10.1.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
